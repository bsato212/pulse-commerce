{
  "name": "pulsecommerce-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade Multi-Warehouse Inventory & Order Fulfillment Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=pulsecommerce-backend",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run start:dev --workspace=pulsecommerce-backend\" \"npm run dev --workspace=pulsecommerce-frontend\"",
    "db:migrate": "npm run migration:run --workspace=pulsecommerce-backend",
    "db:seed": "npm run db:seed --workspace=pulsecommerce-backend",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3"
  }
}
