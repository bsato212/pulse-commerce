datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  WAREHOUSE_MANAGER
  DISPATCHER
  CUSTOMER
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  ALLOCATING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  products    Product[]
  warehouses  Warehouse[]
  orders      Order[]
  webhooks    WebhookSubscription[]

  @@map("tenants")
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]

  @@index([tenantId])
  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  sku         String   @unique
  name        String
  description String
  price       Float
  costPrice   Float
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouseStock WarehouseStock[]
  orderItems     OrderItem[]
  reservations   StockReservation[]

  @@index([tenantId])
  @@index([categoryId])
  @@map("products")
}

model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String   @unique
  name      String
  city      String
  state     String
  country   String
  latitude  Float
  longitude Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stock        WarehouseStock[]
  shipments    Shipment[]
  reservations StockReservation[]

  @@index([tenantId])
  @@map("warehouses")
}

model WarehouseStock {
  id               String    @id @default(uuid())
  warehouseId      String
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity         Int       @default(0)
  reservedQuantity Int       @default(0)
  reorderPoint     Int       @default(10)
  updatedAt        DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@index([productId])
  @@map("warehouse_stocks")
}

model StockReservation {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  orderId     String?
  quantity    Int
  status      String    @default("RESERVED")
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([warehouseId, productId])
  @@index([orderId])
  @@map("stock_reservations")
}

model Order {
  id                String            @id @default(uuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderNumber       String            @unique
  customerId        String
  customer          User              @relation(fields: [customerId], references: [id])
  customerEmail     String
  status            OrderStatus       @default(PENDING)
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  shippingAddress   Json
  subtotal          Float             @default(0.0)
  discountTotal     Float             @default(0.0)
  taxTotal          Float             @default(0.0)
  shippingTotal     Float             @default(0.0)
  grandTotal        Float             @default(0.0)
  currency          String            @default("USD")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items     OrderItem[]
  shipments Shipment[]

  @@index([tenantId])
  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  sku            String
  productName    String
  unitPrice      Float
  quantity       Int
  discountAmount Float    @default(0.0)
  taxAmount      Float    @default(0.0)
  subtotal       Float

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Shipment {
  id             String    @id @default(uuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouseId    String
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  carrier        String
  trackingNumber String?
  status         String    @default("MANIFESTED")
  labelUrl       String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([orderId])
  @@map("shipments")
}

model OutboxEvent {
  id          String       @id @default(uuid())
  eventType   String
  aggregateId String
  payload     Json
  status      OutboxStatus @default(PENDING)
  retryCount  Int          @default(0)
  nextRetryAt DateTime?
  processedAt DateTime?
  createdAt   DateTime     @default(now())

  @@index([status, createdAt])
  @@map("outbox_events")
}

model WebhookSubscription {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url       String
  secret    String
  events    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("webhook_subscriptions")
}
