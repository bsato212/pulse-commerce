# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://pulse_user:pulse_password@localhost:5432/pulse_commerce?schema=public
POSTGRES_USER=pulse_user
POSTGRES_PASSWORD=pulse_password
POSTGRES_DB=pulse_commerce
POSTGRES_PORT=5432

# Cache (Valkey / Redis compatible)
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_DEFAULT_TTL_SECONDS=300

# Authentication
JWT_SECRET=super-secret-pulsecommerce-jwt-signing-key-production-ready-32-chars
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info
